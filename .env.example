# ---------------------------------------------------------------------------------------------
# xa-backend: copiá este archivo a `.env` y editalo. No hay nada más que configurar.
# ---------------------------------------------------------------------------------------------

# Dónde escucha el servidor.
PORT=8787
HOST=0.0.0.0

# Clave compartida entre este servidor y el juego (variable del frontend PUBLIC_XA_BACKEND_TOKEN).
# 16-128 caracteres de A-Z a-z 0-9 . _ -   Generá una con:  npm run token
GAME_TOKEN=change-me-to-a-long-random-token
# (se aceptan varios tokens separados por comas: rotá el token sin cortar el servicio)

# Sitios autorizados a hablar con el servidor, separados por coma, sin barra final. Usá * solo mientras desarrollás.
ALLOWED_ORIGINS=https://xa-portweb.vicemi.dev,http://localhost:4321,http://127.0.0.1:4321

# --- Detrás de Cloudflare (Tunnel / proxy) ----------------------------------------------------
# Cantidad de proxies delante del servidor (Cloudflare Tunnel en la misma máquina = 1).
TRUST_PROXY=1
# true = tomar la dirección del visitante de CF-Connecting-IP. Solo cuando TODO el tráfico pasa por Cloudflare.
TRUST_CLOUDFLARE=true

# --- Cloudflare Zero Trust / Access (opcional) -------------------------------------------------
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_REQUIRED=false

# --- Límites -----------------------------------------------------------------------------------
MAX_ROOMS=200
ROOM_IDLE_MINUTES=30
# Cooperativo de 1 a 4 jugadores (1 = jugar solo).
MAX_COOP_PLAYERS=4
MAX_ROOMS_PER_IP=3
# segundos que se guarda un asiento tras una desconexión (recarga, corte de red)
RECONNECT_GRACE_SECONDS=45
HOST_PLAY_GRACE_SECONDS=12
JOIN_FAIL_LIMIT=12
JOIN_BLOCK_MINUTES=5
MAX_STRIKES=5
# opcional: habilita GET /api/admin/stats (cabecera x-admin-token). 16-128 caracteres
ADMIN_TOKEN=
MAX_CONNECTIONS_PER_IP=8
HTTP_RATE_PER_MINUTE=60
CREATE_ROOM_PER_MINUTE=6
WS_MESSAGES_PER_SECOND=90
WS_MAX_PAYLOAD_BYTES=65536

# --- Dificultad cooperativa --------------------------------------------------------------------
# +10 % de vida de los enemigos por cada amigo conectado
DIFFICULTY_PER_PLAYER=0.10
# dos jugadores = 1.75x los enemigos
ENEMY_COUNT_PER_PLAYER=0.75
# vida extra de los jefes por jugador extra
BOSS_HP_PER_PLAYER=0.5
DIFFICULTY_CAP=3
# castigo por jugar separado: tras 25 s solo, la dificultad sube 2 % por segundo hasta +60 %
SOLO_GRACE_SECONDS=25
SOLO_RAMP_PER_SECOND=0.02
SOLO_PENALTY_CAP=1.6

LOG_LEVEL=info

# --- Conexiones directas entre jugadores (WebRTC) ------------------------------------------------
# STUN / TURN que se entregan a los navegadores (array JSON). STUN es gratis; agregá un TURN (coturn)
# para jugadores con NAT estricta.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.ejemplo.com:3478","username":"usuario","credential":"clave"}]
