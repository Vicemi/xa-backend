{
  "name": "xa-backend",
  "version": "1.0.0",
  "description": "Salas y servidor de retransmisión del modo cooperativo online (hasta 4 jugadores) del port web de Xa. Express (seguridad / transporte) + Elysia (API validada).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/smoke.ts",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(24).toString('hex'))\""
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "elysia": "^1.4.30",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
